# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Per-turn limits (optional). Time spent waiting for your approval never counts toward the timeout.
# ALIL_MAX_ITERATIONS=25        # model steps per turn
# ALIL_TURN_TIMEOUT_MS=600000   # 10 minutes of agent work per turn
# ALIL_MAX_TOKENS=2000000       # cumulative tokens per turn
# ALIL_MAX_COST_USD=5           # cost ceiling per turn

# Crawl4AI MCP server (npm run crawl4ai). The script generates this token into .env on first run.
# CRAWL4AI_API_TOKEN=

{
  "name": "alil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A JARVIS-class assistant harness with structural guardrails and HITL approval.",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "chat": "node --experimental-strip-types --env-file=.env scripts/chat.ts",
    "ui": "node --experimental-strip-types --env-file=.env ui/server.ts",
    "db:setup": "node --experimental-strip-types scripts/db-setup.ts",
    "db:reset": "node --experimental-strip-types scripts/db-setup.ts --reset",
    "memory:demo": "node --experimental-strip-types scripts/memory-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1080.0",
    "better-sqlite3": "^11.10.0",
    "sqlite-vec": "^0.1.6",
    "yaml": "^2.9.0"
  }
}

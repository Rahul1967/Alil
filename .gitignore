node_modules/
dist/

# Secrets — never commit
.env
*.pem
*.key

# Logs
*.log

# ── Runtime state (memory, context, personal) — never pushed; raw code only ──
# The whole workspace/ is generated/operator-owned runtime state: the memory DB,
# world-model, operator dossier, persona, sessions, logs, and attachments. Only the
# directory placeholder is tracked so the app has somewhere to write.
workspace/*
!workspace/.gitkeep
attachments/

# Claude Code local settings + temp files
.claude/
